{
  "name": "velos-site",
  "version": "1.0.0",
  "private": true,
  "description": "Velos digital agency static site",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./assets/styles.css --watch",
    "sync:en": "./sync-en.sh",
    "build": "npm run build:css && npm run sync:en"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "tailwindcss": "^3.4.17"
  }
}
