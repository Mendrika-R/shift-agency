# Velos — security headers + caching (Apache / LiteSpeed on Hostinger).

<IfModule mod_headers.c>
  # --- Security headers ---
  # CSP keeps 'unsafe-inline' for scripts: the page relies on several inline
  # <script> blocks (SITE_CONFIG, I18N, simulator) and GSAP from jsDelivr.
  # connect-src allows the chatbot Worker (prod + preprod).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://shift-chatbot.velos.workers.dev https://shift-chatbot-preprod.velos.workers.dev; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # --- Caching ---
  # Fonts are content-stable and never change name → cache hard.
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Scripts / images are not fingerprinted → short cache so deploys propagate.
  <FilesMatch "\.(js|svg|png|jpe?g|webp|gif|ico)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  # HTML always revalidates (CSS is inlined here, so style changes ship at once).
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Compression for text assets (LiteSpeed/Apache).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
