# Velos — security headers + caching (Apache / LiteSpeed on Hostinger).

<IfModule mod_headers.c>
  # --- Security headers ---
  # CSP keeps 'unsafe-inline' for scripts: the page relies on several inline
  # <script> blocks (SITE_CONFIG, I18N, simulator, GTM) and GSAP from jsDelivr.
  # connect-src allows the chatbot Worker (prod + preprod) and GA4 collection.
  # googletagmanager.com serves gtm.js and the gtag.js the GA4 tag pulls in;
  # frame-src covers the GTM <noscript> iframe.
  # NOTE: frame-ancestors stays 'self', so GTM's in-page Preview mode cannot
  # frame the site — debug with the Tag Assistant Companion extension or GA4
  # DebugView instead of relaxing this.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com; font-src 'self'; connect-src 'self' https://shift-chatbot.velos.workers.dev https://shift-chatbot-preprod.velos.workers.dev https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com; frame-src https://www.googletagmanager.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # same-origin-allow-popups keeps window.open (Calendly/mailto) working.
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

  # --- Caching ---
  # Fonts/scripts/images are cache-busted by a ?v= query in index.html (bump the
  # version when motion.js / chatbot.js / velos-logo.svg change) → cache hard.
  <FilesMatch "\.(woff2|js|svg|png|jpe?g|webp|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML always revalidates (CSS is inlined here, so style changes ship at once).
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Compression for text assets (LiteSpeed/Apache).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
