{
  "name": "Velos — Lead Capture",
  "nodes": [
    {
      "parameters": {
        "path": "velos-lead",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-lead",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "velos-lead-webhook"
    },
    {
      "parameters": {
        "sendTo": "setrynyaina@gmail.com",
        "subject": "=🔔 Nouveau Lead Velos — {{ $json.name }}",
        "emailType": "html",
        "message": "=<h2>Nouveau lead capturé via le chatbot Velos</h2><table border='1' cellpadding='6'><tr><td><b>Nom</b></td><td>{{ $json.name }}</td></tr><tr><td><b>Contact</b></td><td>{{ $json.contact }}</td></tr><tr><td><b>Projet</b></td><td>{{ $json.project_type }}</td></tr><tr><td><b>Langue</b></td><td>{{ $json.lang }}</td></tr><tr><td><b>Session</b></td><td>{{ $json.session_id }}</td></tr><tr><td><b>Date</b></td><td>{{ $json.received_at }}</td></tr></table>",
        "options": {}
      },
      "id": "gmail-send",
      "name": "Gmail — Notification",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [480, 200]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "mode": "id", "value": "REMPLACER_PAR_SPREADSHEET_ID" },
        "sheetName": { "mode": "name", "value": "Leads" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Date": "={{ $json.received_at }}",
            "Nom": "={{ $json.name }}",
            "Contact": "={{ $json.contact }}",
            "Projet": "={{ $json.project_type }}",
            "Langue": "={{ $json.lang }}",
            "Session": "={{ $json.session_id }}"
          }
        },
        "options": {}
      },
      "id": "gsheets-append",
      "name": "Google Sheets — Append",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [480, 420]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"ok\": true }",
        "options": {}
      },
      "id": "respond-ok",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[
        { "node": "Gmail — Notification", "type": "main", "index": 0 },
        { "node": "Google Sheets — Append", "type": "main", "index": 0 }
      ]]
    },
    "Gmail — Notification": { "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]] },
    "Google Sheets — Append": { "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
