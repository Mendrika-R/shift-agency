# Copie ce fichier en .env (ignoré par git) et renseigne les valeurs.
# Utilisé par scripts/reindex.sh et scripts/ingest.js.

# URL du Worker Cloudflare déployé
WORKER_URL=https://shift-chatbot.velos.workers.dev

# Secret d'ingestion — doit correspondre au secret du Worker
# (configuré côté Worker avec : wrangler secret put INGEST_SECRET)
INGEST_SECRET=
